# ── 依赖 ──────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/

# ── 构建产物 ──────────────────────────────────────────────────────────
# tsc 把声明输出到 lib/types，tsdown 输出 lib/index.js 与 lib/client.js。
# lib/ 完全由源码构建，不入库；从 git 安装时由 package.json 的 prepare 脚本重建。
lib/
dist/
build/
out/
*.tsbuildinfo

# ── 日志 ──────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── 环境变量与本地凭据 ────────────────────────────────────────────────
.env
.env.*
!.env.example
.npmrc.local

# ── 编辑器与 IDE ──────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~
.#*
\#*\#

# ── 操作系统 ──────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── 测试与覆盖率 ──────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
junit.xml

# ── 缓存与临时文件 ────────────────────────────────────────────────────
.cache/
.tmp/
.tmp-*/
temp/
*.tgz
*.tar.gz
.eslintcache
.oxlintcache

# ── 本机实际使用的 MCP 服务清单 ───────────────────────────────────────
# 根目录的 mcp.json 是这台机器真正在跑的清单，可能含 token，不入库。
# examples/mcp.json 是随包发布的示例，必须入库，所以这里只用锚定到根目录的路径。
/mcp.json
